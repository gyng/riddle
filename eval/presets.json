{
  "$comment": "Idle-game specialisation of ../eval-fun (Fun Framework v4). Same 14 axes and anchors, plus two idle-specific axes (return, attribution). Genre presets here are for idle games only; use ../eval-fun/presets/presets.json for anything else. Scored with ../eval-fun/tools/fun-score.mjs via `presets` in the card (see eval/score.sh).",
  "axes": [
    { "id": "clarity", "name": "Clear goal and feedback", "layer": "core" },
    { "id": "decisions", "name": "Interesting decisions", "layer": "engine" },
    { "id": "mastery", "name": "Mastery curve", "layer": "core" },
    { "id": "tension", "name": "Tension, risk and release", "layer": "engine" },
    { "id": "feel", "name": "Feel and juice", "layer": "engine" },
    { "id": "surprise", "name": "Surprise and variety", "layer": "core" },
    { "id": "expression", "name": "Expression and identity", "layer": "engine" },
    { "id": "story", "name": "Story to tell", "layer": "conditional" },
    { "id": "pacing", "name": "Flow and pacing", "layer": "core" },
    { "id": "failure", "name": "Fairness and legibility of failure", "layer": "core" },
    { "id": "social", "name": "Social and relatedness", "layer": "conditional" },
    { "id": "autonomy", "name": "Autonomy and exploration", "layer": "conditional" },
    { "id": "progression", "name": "Collection and progression", "layer": "retention" },
    { "id": "aesthetic", "name": "Atmosphere and audiovisual appeal", "layer": "conditional" },
    { "id": "return", "name": "Return payoff (idle)", "layer": "idle-core" },
    { "id": "attribution", "name": "Attribution of the agent's play (idle)", "layer": "idle-core" }
  ],
  "genres": {
    "idler": {
      "$comment": "Pure incremental (Cookie Clicker, Antimatter Dimensions). eval-fun's idler weights plus the two idle axes; attribution is 0 because nothing plays on the player's behalf.",
      "weights": { "clarity": 3, "decisions": 2, "mastery": 1, "tension": 0, "feel": 1, "surprise": 2, "expression": 1, "story": 1, "pacing": 3, "failure": 0, "social": 0, "autonomy": 0, "progression": 3, "aesthetic": 0, "return": 3, "attribution": 0 }
    },
    "idle-rpg": {
      "$comment": "Auto-battling idle RPG (Melvor combat, Idle Champions, NGU adventure). The agent plays; the player configures.",
      "weights": { "clarity": 3, "decisions": 2, "mastery": 1, "tension": 1, "feel": 1, "surprise": 2, "expression": 2, "story": 1, "pacing": 3, "failure": 1, "social": 0, "autonomy": 0, "progression": 3, "aesthetic": 1, "return": 3, "attribution": 2 }
    },
    "idle-roguelike": {
      "$comment": "Riddle's preset: a real roguelike played by an agent the player programs. Decisions live in the rule layer; surprise/story come from the dungeon; failure is the hinge (death -> rule edit); return and attribution are the idle spine.",
      "weights": { "clarity": 3, "decisions": 3, "mastery": 2, "tension": 2, "feel": 1, "surprise": 3, "expression": 3, "story": 3, "pacing": 3, "failure": 3, "social": 0, "autonomy": 1, "progression": 3, "aesthetic": 1, "return": 3, "attribution": 3 }
    }
  },
  "profiles": {
    "$comment": "Quantic Foundry clusters, as in eval-fun, extended to the two idle axes.",
    "action":      { "feel": 1.4, "tension": 1.3, "pacing": 1.2, "story": 0.8, "progression": 0.9 },
    "social":      { "social": 1.8, "expression": 1.2, "story": 1.2, "mastery": 0.8 },
    "mastery":     { "mastery": 1.5, "decisions": 1.3, "failure": 1.3, "aesthetic": 0.8, "story": 0.8, "attribution": 1.2 },
    "achievement": { "progression": 1.6, "mastery": 1.2, "clarity": 1.1, "surprise": 0.9, "return": 1.3 },
    "immersion":   { "story": 1.5, "aesthetic": 1.5, "autonomy": 1.2, "feel": 0.9, "decisions": 0.9 },
    "creativity":  { "expression": 1.6, "autonomy": 1.4, "surprise": 1.2, "tension": 0.8, "attribution": 1.2 }
  }
}
